# Gemini CLI Bridge MCP Server 配置文件
# 复制此文件为 .env 并填入实际的配置值

# 自定义 AI API 配置（必填）
CUSTOM_AI_API_URL=http://llm-32b.jd.com/v1/chat/completions
CUSTOM_AI_MODEL=qwen25-32b-native
CUSTOM_AI_API_KEY=your-api-key-here

# Gemini CLI 配置
GEMINI_CLI_PATH=gemini
GEMINI_CLI_WORKSPACE=./workspace
GEMINI_CLI_CONFIG_DIR=./config

# API 代理配置
API_PROXY_PORT=8888
API_PROXY_HOST=localhost

# 可选配置
BRIDGE_LOG_LEVEL=INFO
BRIDGE_TIMEOUT=60
BRIDGE_MAX_RETRIES=3

# 高级配置
GEMINI_CLI_ARGS=--no-browser --json-output
CUSTOM_SETTINGS_JSON=./config/settings.json