{
  "name": "gemini-cli-custom-bridge",
  "version": "1.0.0",
  "description": "MCP Server to bridge Gemini CLI with Custom AI API",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "configure-gemini": "node scripts/configure-gemini.js",
    "postinstall": "npm run build",
    "setup": "npm run build && npm run configure-gemini"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "dotenv": "^16.3.1",
    "glob": "^11.0.3",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "mcp",
    "gemini-cli",
    "custom",
    "ai",
    "bridge"
  ],
  "author": "JoyCode",
  "license": "MIT"
}
